# Copy to .env.production (or set in the environment / GitHub Actions variables) when the
# app is hosted somewhere other than the Worker itself. Leave unset for `npm run dev`, which
# proxies /api to `wrangler dev`, and for a build the Worker serves from web/dist.
VITE_API_BASE=https://kartz.<your-subdomain>.workers.dev/api
# Where the app lives on its host: '/kartz/' on GitHub Pages, '/' on the Worker.
BASE_PATH=/kartz/
